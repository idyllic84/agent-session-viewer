# Copy to server/deploy/.env (ignored by git), then chmod 600.
# VM / Cloudflare only. Local Compose works without an .env file.
VIEWER_PUBLIC_ORIGIN=https://history.example.com
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token

# Optional: pin image tags/digests for reproducible production upgrades.
# CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:...
# VIEWER_IMAGE=agent-session-viewer:latest
# VCS_REF=your-commit
# VIEWER_MAX_REQUEST_MIB=32

# Local Compose optional override, kept separate from production data.
# VIEWER_LOCAL_PORT=41880

# Owner login and browser session keys are generated once in the named volume.
# They are NOT the Cloudflare tunnel token or a Syncer device token.
